# ============================================
# CreatorPulse AI Service — Environment Variables
# ============================================

# === Required ===
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_SERVICE_KEY=your-shared-secret-here

# === Optional (defaults shown) ===
# OPENAI_MODEL=gpt-4o-mini
# MAX_ARTICLE_LENGTH=5000
# PORT=8000
# DEBUG=false

# === Image Generation ===
# Pollinations AI: NO key needed — works immediately (Flux model)
# Gemini: Get free key at https://aistudio.google.com → ~500 images/day
# GEMINI_API_KEY=your-google-ai-studio-key-here
